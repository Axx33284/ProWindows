#include <windows.h>
#include <commctrl.h>
#include "../src/resource.h"

IDI_APPICON ICON        "app.ico"
1           RT_MANIFEST "app.manifest"

/////////////////////////////////////////////////////////////////////////////
// Settings shell: header, tabs, action buttons.

IDD_SETTINGS DIALOGEX 0, 0, 364, 440
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "ProWindows"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APPICON, IDC_APPICON_STATIC, 10, 10, 20, 20
    LTEXT           "ProWindows", IDC_TITLE, 39, 9, 200, 14
    LTEXT           "Starting...", IDC_STATUS_TEXT, 39, 24, 240, 9
    PUSHBUTTON      "&Pause tiling", IDC_TOGGLE_TILING, 288, 12, 66, 18

    CONTROL         "", IDC_TABS, "SysTabControl32", TCS_TABS | WS_TABSTOP,
                    7, 38, 350, 372

    PUSHBUTTON      "Ad&vanced (config file)...", IDC_BTN_EDITCFG, 7, 417, 94, 16
    PUSHBUTTON      "&Re-arrange now", IDC_BTN_RETILE, 105, 417, 66, 16
    DEFPUSHBUTTON   "&Apply", IDC_APPLY, 243, 417, 54, 16
    PUSHBUTTON      "&Hide to tray", IDC_HIDE, 301, 417, 56, 16
END

/////////////////////////////////////////////////////////////////////////////
// Page 1 - Layout

IDD_PAGE_LAYOUT DIALOGEX 0, 0, 340, 310
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "How should windows be arranged?", IDC_STATIC, 8, 8, 160, 9
    COMBOBOX        IDC_LAYOUT, 8, 20, 118, 120,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_LAYOUT_PREVIEW, "Static", SS_OWNERDRAW,
                    8, 40, 118, 80
    LTEXT           "", IDC_LAYOUT_DESC, 136, 20, 196, 100

    GROUPBOX        "Main area size", IDC_STATIC, 8, 128, 324, 46
    CONTROL         "", IDC_MASTER_SLIDER, "msctls_trackbar32",
                    TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 18, 142, 150, 14
    LTEXT           "55%", IDC_MASTER_VALUE, 174, 145, 26, 9
    LTEXT           "", IDC_MASTER_HINT, 18, 160, 306, 9

    GROUPBOX        "Spacing", IDC_STATIC, 8, 180, 324, 42
    LTEXT           "Between windows:", IDC_STATIC, 18, 198, 64, 9
    EDITTEXT        IDC_GAP_INNER, 86, 196, 26, 12, ES_RIGHT | ES_NUMBER | WS_TABSTOP
    LTEXT           "px", IDC_STATIC, 116, 198, 10, 9
    LTEXT           "Around screen edge:", IDC_STATIC, 172, 198, 70, 9
    EDITTEXT        IDC_GAP_OUTER, 246, 196, 26, 12, ES_RIGHT | ES_NUMBER | WS_TABSTOP
    LTEXT           "px", IDC_STATIC, 276, 198, 10, 9

    GROUPBOX        "Workspaces", IDC_STATIC, 8, 228, 324, 40
    LTEXT           "How many:", IDC_STATIC, 18, 245, 40, 9
    EDITTEXT        IDC_WORKSPACES, 62, 243, 24, 13, ES_RIGHT | ES_NUMBER | WS_TABSTOP
    LTEXT           "", IDC_WORKSPACE_HINT, 96, 245, 228, 18

    GROUPBOX        "Keep space clear for a bar", IDC_STATIC, 8, 274, 324, 60
    LTEXT           "Reserve room on any edge and tiled windows will never sit underneath it.",
                    IDC_STATIC, 18, 290, 306, 9
    LTEXT           "Top:", IDC_STATIC, 18, 310, 22, 9
    EDITTEXT        IDC_MARGIN_TOP, 42, 308, 26, 13, ES_RIGHT | ES_NUMBER | WS_TABSTOP
    LTEXT           "Bottom:", IDC_STATIC, 80, 310, 28, 9
    EDITTEXT        IDC_MARGIN_BOTTOM, 110, 308, 26, 13, ES_RIGHT | ES_NUMBER | WS_TABSTOP
    LTEXT           "Left:", IDC_STATIC, 148, 310, 22, 9
    EDITTEXT        IDC_MARGIN_LEFT, 172, 308, 26, 13, ES_RIGHT | ES_NUMBER | WS_TABSTOP
    LTEXT           "Right:", IDC_STATIC, 210, 310, 24, 9
    EDITTEXT        IDC_MARGIN_RIGHT, 236, 308, 26, 13, ES_RIGHT | ES_NUMBER | WS_TABSTOP
    LTEXT           "px", IDC_STATIC, 266, 310, 12, 9
END

/////////////////////////////////////////////////////////////////////////////
// Page 2 - Behaviour

IDD_PAGE_BEHAVIOUR DIALOGEX 0, 0, 340, 310
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "While you work", IDC_STATIC, 8, 4, 324, 102
    CONTROL         "Highlight the focused window with a coloured border",
                    IDC_CHK_BORDER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 18, 300, 10
    CONTROL         "Focus follows the mouse pointer",
                    IDC_CHK_FFM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 32, 300, 10
    CONTROL         "Drag a window onto one side of another to move it there",
                    IDC_CHK_DRAGSWAP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 46, 300, 10
    CONTROL         "Hold the modifier and drag anywhere on a window to move it",
                    IDC_CHK_MODDRAG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 60, 300, 10
    CONTROL         "Place new windows before the focused one",
                    IDC_CHK_NEWTOP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 74, 300, 10
    CONTROL         "Stop completely while a game or other fullscreen app is running",
                    IDC_CHK_GAMEPAUSE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 88, 300, 10

    GROUPBOX        "Motion", IDC_STATIC, 8, 112, 324, 40
    CONTROL         "Slide windows into place instead of snapping",
                    IDC_CHK_ANIM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 126, 190, 10
    LTEXT           "Speed:", IDC_STATIC, 216, 127, 26, 9
    COMBOBOX        IDC_ANIM_SPEED, 246, 124, 76, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Never arrange these apps", IDC_STATIC, 8, 158, 324, 98
    LISTBOX         IDC_EXCLUDE_LIST, 18, 172, 200, 74,
                    LBS_NOTIFY | LBS_HASSTRINGS | LBS_SORT | WS_VSCROLL |
                    WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "A&dd running app...", IDC_BTN_ADD_RUNNING, 226, 172, 96, 16
    PUSHBUTTON      "&Browse for .exe...", IDC_BTN_ADD_BROWSE, 226, 192, 96, 16
    PUSHBUTTON      "Re&move", IDC_BTN_REMOVE, 226, 212, 96, 16

    LTEXT           "Startup, the settings file and diagnostics are on the General tab.",
                    IDC_STATIC, 8, 264, 324, 9
END

/////////////////////////////////////////////////////////////////////////////
// Page 3 - Shortcuts

IDD_PAGE_SHORTCUTS DIALOGEX 0, 0, 340, 310
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Modifier key:", IDC_STATIC, 8, 10, 44, 9
    COMBOBOX        IDC_MODIFIER, 54, 8, 76, 120,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Every shortcut below marked $mod uses this key.",
                    IDC_STATIC, 138, 10, 196, 9

    CONTROL         "", IDC_BINDLIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS |
                    WS_BORDER | WS_TABSTOP, 8, 26, 324, 202

    PUSHBUTTON      "&Change key...", IDC_BIND_EDIT, 8, 232, 74, 16
    PUSHBUTTON      "Re&move", IDC_BIND_REMOVE, 86, 232, 60, 16
    PUSHBUTTON      "Reset all &keys", IDC_BIND_RESET, 262, 232, 70, 16

    LTEXT           "", IDC_BIND_HINT, 8, 256, 324, 28
END

/////////////////////////////////////////////////////////////////////////////
// Page 4 - Opening apps

IDD_PAGE_APPS DIALOGEX 0, 0, 340, 310
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Press a key and an app opens. These are separate from the window shortcuts.",
                    IDC_STATIC, 8, 8, 324, 9

    CONTROL         "", IDC_APPLIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS |
                    WS_BORDER | WS_TABSTOP, 8, 22, 324, 176

    PUSHBUTTON      "&Add an app...", IDC_APP_ADD, 8, 204, 74, 16
    PUSHBUTTON      "Add a &file or program...", IDC_APP_BROWSE, 86, 204, 96, 16
    PUSHBUTTON      "&Change key...", IDC_APP_EDITKEY, 186, 204, 70, 16
    PUSHBUTTON      "Re&move", IDC_APP_REMOVE, 260, 204, 72, 16

    CONTROL         "Take over shortcuts Windows reserves (Win+B, Win+E, Win+F, Win+Q...)",
                    IDC_CHK_OVERRIDE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    8, 230, 324, 10
    LTEXT           "", IDC_APP_HINT, 20, 244, 312, 56
END

/////////////////////////////////////////////////////////////////////////////
// Page 5 - System monitor

IDD_PAGE_MONITOR DIALOGEX 0, 0, 340, 362
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "Show the floating system monitor",
                    IDC_MON_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    8, 6, 214, 12
    CONTROL         "Pin it in place (locked, and clicks pass through)",
                    IDC_MON_PINNED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    8, 22, 224, 12
    CONTROL         "Sit on the desktop, behind every window",
                    IDC_MON_DESKTOP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    8, 38, 224, 12
    PUSHBUTTON      "Reset position", IDC_MON_RESET_POS, 238, 20, 94, 16

    GROUPBOX        "What to show, and in what order", IDC_STATIC, 8, 58, 150, 142
    CONTROL         "", IDC_MON_SHOW_FIRST + 0, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 74, 108, 12
    CONTROL         "", IDC_MON_COL_FIRST + 0, "Button", BS_OWNERDRAW | WS_TABSTOP,
                    130, 73, 20, 12
    CONTROL         "", IDC_MON_SHOW_FIRST + 1, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 87, 108, 12
    CONTROL         "", IDC_MON_COL_FIRST + 1, "Button", BS_OWNERDRAW | WS_TABSTOP,
                    130, 86, 20, 12
    CONTROL         "", IDC_MON_SHOW_FIRST + 2, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 100, 108, 12
    CONTROL         "", IDC_MON_COL_FIRST + 2, "Button", BS_OWNERDRAW | WS_TABSTOP,
                    130, 99, 20, 12
    CONTROL         "", IDC_MON_SHOW_FIRST + 3, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 113, 108, 12
    CONTROL         "", IDC_MON_COL_FIRST + 3, "Button", BS_OWNERDRAW | WS_TABSTOP,
                    130, 112, 20, 12
    CONTROL         "", IDC_MON_SHOW_FIRST + 4, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 126, 108, 12
    CONTROL         "", IDC_MON_COL_FIRST + 4, "Button", BS_OWNERDRAW | WS_TABSTOP,
                    130, 125, 20, 12
    CONTROL         "", IDC_MON_SHOW_FIRST + 5, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 139, 108, 12
    CONTROL         "", IDC_MON_COL_FIRST + 5, "Button", BS_OWNERDRAW | WS_TABSTOP,
                    130, 138, 20, 12
    CONTROL         "", IDC_MON_SHOW_FIRST + 6, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 152, 108, 12
    CONTROL         "", IDC_MON_COL_FIRST + 6, "Button", BS_OWNERDRAW | WS_TABSTOP,
                    130, 151, 20, 12
    CONTROL         "", IDC_MON_SHOW_FIRST + 7, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 165, 108, 12
    CONTROL         "", IDC_MON_COL_FIRST + 7, "Button", BS_OWNERDRAW | WS_TABSTOP,
                    130, 164, 20, 12
    PUSHBUTTON      "Move up", IDC_MON_ORDER_UP, 18, 180, 62, 15
    PUSHBUTTON      "Move down", IDC_MON_ORDER_DOWN, 88, 180, 62, 15


    GROUPBOX        "Appearance", IDC_STATIC, 166, 58, 166, 134
    LTEXT           "Style", IDC_STATIC, 176, 78, 24, 9
    COMBOBOX        IDC_MON_STYLE, 204, 75, 120, 220,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "History graphs", IDC_MON_GRAPHS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 176, 96, 150, 12
    CONTROL         "Name the busiest app", IDC_MON_TOPAPP, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 176, 112, 150, 12
    CONTROL         "Stack vertically", IDC_MON_VERTICAL, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 176, 128, 150, 12
    LTEXT           "Opacity", IDC_STATIC, 176, 150, 30, 9
    CONTROL         "", IDC_MON_OPACITY, "msctls_trackbar32",
                    TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 208, 146, 84, 16
    LTEXT           "92%", IDC_MON_OPACITY_VAL, 296, 150, 28, 9
    LTEXT           "Size", IDC_STATIC, 176, 172, 30, 9
    CONTROL         "", IDC_MON_SCALE, "msctls_trackbar32",
                    TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 208, 168, 84, 16
    LTEXT           "100%", IDC_MON_SCALE_VAL, 296, 172, 30, 9

    GROUPBOX        "Colours", IDC_STATIC, 8, 204, 324, 92
    COMBOBOX        IDC_MON_THEME, 18, 222, 116, 240,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_MON_THEME_DESC, 18, 242, 116, 28
    PUSHBUTTON      "Use theme colours", IDC_MON_COL_RESET, 18, 272, 116, 15
    CONTROL         "", IDC_MON_PREVIEW, "Static", SS_OWNERDRAW,
                    144, 216, 178, 74

    GROUPBOX        "Refresh", IDC_STATIC, 8, 302, 150, 42
    LTEXT           "Update every", IDC_STATIC, 18, 320, 46, 9
    COMBOBOX        IDC_MON_INTERVAL, 66, 317, 86, 120,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "", IDC_MON_HINT, 166, 300, 168, 58
END

/////////////////////////////////////////////////////////////////////////////
// Page 6 - Search bar

IDD_PAGE_SEARCH DIALOGEX 0, 0, 340, 350
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Win+S opens the search bar. Installed apps are always searched; these are the other things it can find.",
                    IDC_STATIC, 8, 8, 324, 18

    GROUPBOX        "What to search", IDC_STATIC, 8, 30, 324, 76
    CONTROL         "Files, folders and programs", IDC_SRCH_FILES, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 18, 48, 150, 12
    CONTROL         "Windows settings pages", IDC_SRCH_SETTINGS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 18, 64, 150, 12
    CONTROL         "Calculator (type a sum, Enter copies the answer)",
                    IDC_SRCH_CALC, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 176, 48, 148, 12
    CONTROL         "Run what I typed as a command", IDC_SRCH_COMMANDS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 176, 64, 148, 12
    LTEXT           "", IDC_SRCH_HINT, 18, 82, 306, 18

    GROUPBOX        "Folders to index", IDC_STATIC, 8, 112, 324, 150
    CONTROL         "", IDC_SRCH_FOLDERS, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER |
                    WS_BORDER | WS_TABSTOP, 18, 130, 306, 82

    PUSHBUTTON      "&Add a folder...", IDC_SRCH_ADD, 18, 218, 82, 16
    PUSHBUTTON      "Re&move", IDC_SRCH_REMOVE, 104, 218, 62, 16
    PUSHBUTTON      "Use the &default folders", IDC_SRCH_DEFAULTS, 170, 218, 96, 16

    LTEXT           "Depth", IDC_STATIC, 18, 244, 22, 9
    COMBOBOX        IDC_SRCH_DEPTH, 42, 241, 80, 160,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Ceiling", IDC_STATIC, 130, 244, 26, 9
    COMBOBOX        IDC_SRCH_MAXENTRIES, 160, 241, 76, 160,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Include hidden files", IDC_SRCH_HIDDEN, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 244, 243, 80, 12

    GROUPBOX        "Where to look for programs", IDC_STATIC, 8, 266, 324, 56
    CONTROL         "Every drive on this PC, not only the one Windows is on",
                    IDC_SRCH_DRIVES, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 18, 282, 306, 12
    CONTROL         "Include an app's own helper .exe files (many more results)",
                    IDC_SRCH_DEEPEXE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 18, 296, 306, 12
    LTEXT           "", IDC_SRCH_DRIVELIST, 18, 310, 306, 9

    LTEXT           "", IDC_SRCH_STATUS, 18, 330, 200, 18
    PUSHBUTTON      "&Rebuild the index now", IDC_SRCH_REINDEX, 224, 328, 100, 16
END

/////////////////////////////////////////////////////////////////////////////
// Page 7 - General: setup and maintenance

IDD_PAGE_GENERAL DIALOGEX 0, 0, 340, 310
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Starting with Windows", IDC_STATIC, 8, 6, 324, 74
    CONTROL         "Start automatically when Windows starts",
                    IDC_CHK_AUTOSTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 22, 304, 10
    CONTROL         "Start hidden in the notification area",
                    IDC_CHK_STARTMIN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 36, 304, 10
    CONTROL         "Start as administrator, so elevated windows can be arranged too",
                    IDC_CHK_ELEVAUTO, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
                    18, 50, 304, 10
    LTEXT           "One registry entry under HKCU. No service, no scheduled task, unless you tick the third box.",
                    IDC_STATIC, 18, 64, 304, 9

    GROUPBOX        "Your settings", IDC_STATIC, 8, 88, 324, 62
    LTEXT           "Everything on these tabs is written to config.ini, which stays commented so it can be edited by hand.",
                    IDC_STATIC, 18, 104, 304, 18
    PUSHBUTTON      "Open the &config file", IDC_GEN_OPENCFG, 18, 126, 96, 16
    PUSHBUTTON      "Open the &folder", IDC_GEN_OPENDIR, 120, 126, 84, 16
    PUSHBUTTON      "Re&load from disk", IDC_GEN_RELOAD, 210, 126, 88, 16

    GROUPBOX        "If something looks wrong", IDC_STATIC, 8, 158, 324, 76
    LTEXT           "A window sitting on top of everything is usually one running as administrator, or one hidden by a workspace switch.",
                    IDC_STATIC, 18, 174, 304, 18
    PUSHBUTTON      "&Diagnostics report...", IDC_GEN_DIAG, 18, 196, 96, 16
    PUSHBUTTON      "Show all &hidden windows", IDC_GEN_RESTOREWINS, 120, 196, 106, 16
    PUSHBUTTON      "&Restore defaults...", IDC_GEN_RESET, 232, 196, 90, 16
    LTEXT           "Restoring defaults discards your shortcuts, exclusions and learned window sizes.",
                    IDC_STATIC, 18, 216, 304, 9

    GROUPBOX        "About", IDC_STATIC, 8, 242, 324, 62
    LTEXT           "", IDC_GEN_ABOUT, 18, 258, 304, 40
END

/////////////////////////////////////////////////////////////////////////////
// "Choose an app" picker

IDD_PICKAPP DIALOGEX 0, 0, 250, 214
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose an app"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_PICK_PROMPT, 7, 7, 236, 9
    EDITTEXT        IDC_PICK_FILTER, 7, 19, 236, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LISTBOX         IDC_PICK_LIST, 7, 38, 236, 148,
                    LBS_NOTIFY | LBS_HASSTRINGS | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "Add", IDOK, 135, 192, 52, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 191, 192, 52, 16
END

/////////////////////////////////////////////////////////////////////////////
// Shortcut editor

IDD_BINDEDIT DIALOGEX 0, 0, 268, 132
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Shortcut"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Action:", IDC_STATIC, 7, 9, 34, 9
    LTEXT           "", IDC_BINDEDIT_LABEL, 45, 9, 216, 18

    LTEXT           "Program:", IDC_BINDEDIT_PROGLABEL, 7, 32, 34, 9
    EDITTEXT        IDC_BINDEDIT_COMMAND, 45, 30, 155, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_BINDEDIT_BROWSE, 205, 30, 56, 13

    LTEXT           "Press the key combination you want:", IDC_STATIC, 7, 54, 180, 9
    EDITTEXT        IDC_BINDEDIT_CAPTURE, 7, 66, 254, 14,
                    ES_READONLY | ES_CENTER | WS_TABSTOP
    LTEXT           "", IDC_BINDEDIT_HINT, 7, 85, 254, 20

    DEFPUSHBUTTON   "OK", IDOK, 153, 110, 52, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 209, 110, 52, 16
END

/////////////////////////////////////////////////////////////////////////////

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     1,2,0,0
    PRODUCTVERSION  1,2,0,0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       0x0L
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "ProWindows"
            VALUE "FileDescription",  "Automatic tiling window manager for Windows 11"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "ProWindows"
            VALUE "OriginalFilename", "ProWindows.exe"
            VALUE "ProductName",      "ProWindows"
            VALUE "ProductVersion",   "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
